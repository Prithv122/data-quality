# Copy to .env and fill in. Never commit .env.

# Optional: post alerts to Slack (`dq run --slack`). An incoming-webhook URL.
DQ_SLACK_WEBHOOK_URL=

# Optional: the real 22-elt-dbt-dagster Postgres for the drift guard and `dq run --source postgres`.
# These are #22's documented local-development defaults.
DQ_POSTGRES_DSN=postgresql://weather:weather@localhost:5432/weather
